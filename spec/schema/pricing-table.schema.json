{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/reearth/okibi/spec/schema/pricing-table.schema.json",
  "title": "pricing table",
  "description": "Unit prices for one profile in one month. Append-only: see spec/okibi-contract.md.",
  "type": "object",
  "properties": {
    "pricing": { "const": "okibi-pricing/1" },
    "profile": {
      "description": "Matched against a manifest's cost.billing.pricing_profile.",
      "type": "string",
      "minLength": 1
    },
    "effective": {
      "description": "The month this table states prices for, as YYYY-MM.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "units": {
      "description": "Price of one of each resource a manifest's billing counts.",
      "type": "object",
      "properties": {
        "cpu_ms": { "type": "number", "minimum": 0 },
        "subrequest": { "type": "number", "minimum": 0 },
        "storage_class_a": { "type": "number", "minimum": 0 },
        "egress_byte": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": { "type": "number", "minimum": 0 }
    }
  },
  "required": ["pricing", "profile", "effective", "currency", "units"],
  "additionalProperties": false
}
