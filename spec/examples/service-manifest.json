{
  "manifest": "okibi-service/1",
  "service": "papers",
  "url_template": "https://papers.reearth.land/t/{tileset}/{id}?e={epoch.param}",
  "meta_urls": {
    "tileset": "https://papers.reearth.land/t/{tileset}/meta.json"
  },
  "cost": {
    "default_gen_ms": 30000,
    "default_bytes": 90000,
    "concurrency_limit": 4,
    "rate_per_s": 2,
    "billing": {
      "pricing_profile": "cloudflare",
      "per_gen": {
        "cpu_ms": null,
        "class_a_operation": 1,
        "egress_byte": null
      }
    }
  },
  "lanes": {
    "interactive_priority": true
  },
  "depends_on": [
    {
      "service": "terrain",
      "reason": "elevation lookup",
      "order": "before"
    }
  ],
  "zoom_semantics": "resolution"
}
