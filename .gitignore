# Design notes, which live beside the code rather than in it.
/tmp

# Build output, at any depth. Rooted at `/target` this would miss the one a
# standalone crate makes for itself.
target/

node_modules/
dist/

# wasm-pack writes its output here, next to the package that publishes it.
packages/okibi/bundler/
packages/okibi/nodejs/
packages/okibi/workerd/

# Staged into each package at publish time, from the copies at the root.
packages/*/LICENSE-MIT
packages/*/LICENSE-APACHE
