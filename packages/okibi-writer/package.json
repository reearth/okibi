{
  "name": "@reearth/okibi-writer",
  "version": "0.1.0",
  "description": "Writes tile-demand events from a service, bound to a log backend",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/reearth/okibi.git",
    "directory": "packages/okibi-writer"
  },
  "homepage": "https://github.com/reearth/okibi",
  "keywords": ["tiles", "cache", "analytics-engine", "cloudflare-workers", "observability"],
  "type": "module",
  "packageManager": "npm@11.15.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": ["dist", "README.md", "LICENSE-MIT", "LICENSE-APACHE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && ../../scripts/stage-licenses.sh"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
