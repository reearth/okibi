{
  "name": "@reearth/okibi",
  "version": "0.1.0",
  "description": "Tile-demand events, quadkey projection and demand digests, for services okibi warms",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/reearth/okibi.git",
    "directory": "packages/okibi"
  },
  "homepage": "https://github.com/reearth/okibi",
  "keywords": [
    "tiles",
    "quadkey",
    "cache",
    "cache-warming",
    "wasm",
    "cloudflare-workers",
    "analytics-engine"
  ],
  "type": "module",
  "packageManager": "npm@11.15.0",
  "exports": {
    ".": {
      "workerd": {
        "types": "./bundler/okibi.d.ts",
        "default": "./bundler/okibi.js"
      },
      "node": {
        "types": "./nodejs/okibi.d.ts",
        "default": "./nodejs/okibi.js"
      },
      "import": {
        "types": "./bundler/okibi.d.ts",
        "default": "./bundler/okibi.js"
      }
    },
    "./writer": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bundler": {
      "types": "./bundler/okibi.d.ts",
      "default": "./bundler/okibi.js"
    },
    "./nodejs": {
      "types": "./nodejs/okibi.d.ts",
      "default": "./nodejs/okibi.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bundler",
    "nodejs",
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": [
    "*.wasm",
    "./bundler/okibi.js",
    "./nodejs/okibi.js"
  ],
  "scripts": {
    "build": "../../scripts/build-wasm.sh --release && tsc --project tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && ../../scripts/stage-licenses.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
